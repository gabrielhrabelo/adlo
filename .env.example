# Copy this file to `.env` and replace the placeholders with your real values.

# Usados pelo compose.yaml para subir o PostgreSQL (>= 15)
POSTGRES_USER="adlo"
POSTGRES_PASSWORD="change-me"
POSTGRES_DATABASE="adlo"

# Connection string do PostgreSQL. Caracteres especiais na senha precisam
# ser URL-encoded (ex.: "@" vira "%40").
DATABASE_URL="postgresql://adlo:change-me@localhost:5432/adlo"

# Segredo para assinar os tokens de acesso (mínimo 32 caracteres).
# Gere um com: openssl rand -base64 48
JWT_SECRET=""

PORT=3333
