meta {
  name: Histórico do cliente
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/clientes/{{clienteId}}/atendimentos?page=1&pageSize=20
  body: none
  auth: inherit
}

params:query {
  page: 1
  pageSize: 20
  ~canal: PRESENCIAL
  ~processoId: {{processoId}}
  ~de: 2026-01-01
  ~ate: 2026-12-31
  ~busca: laudo
}

docs {
  RF11 - Consultar histórico de atendimentos por cliente.
}
