meta {
  name: Registrar atendimento
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/clientes/{{clienteId}}/atendimentos
  body: json
  auth: inherit
}

body:json {
  {
    "processoId": "{{processoId}}",
    "assunto": "Entrega de laudo médico",
    "conteudo": "Cliente trouxe o laudo atualizado do ortopedista.",
    "canal": "PRESENCIAL"
  }
}

script:post-response {
  if (res.status === 201) bru.setEnvVar("atendimentoId", res.body.id);
}

docs {
  RF10 - Registrar atendimento. `processoId` é opcional.
}
