meta {
  name: Incluir agendamento
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/agendamentos
  body: json
  auth: inherit
}

body:json {
  {
    "clienteId": "{{clienteId}}",
    "processoId": "{{processoId}}",
    "titulo": "Audiência de instrução",
    "tipo": "AUDIENCIA",
    "dataHora": "{{dataHora}}",
    "duracaoMinutos": 60,
    "antecedenciaMinutos": 1440
  }
}

script:pre-request {
  // Agenda para daqui a 2 dias, às 14h (horário de Brasília)
  const data = new Date(Date.now() + 2 * 24 * 60 * 60 * 1000);
  const dia = data.toISOString().slice(0, 10);
  bru.setVar("dataHora", `${dia}T17:00:00.000Z`);
  bru.setVar("dataHoraRemarcada", `${dia}T19:00:00.000Z`);
}

script:post-response {
  if (res.status === 201) bru.setEnvVar("agendamentoId", res.body.id);
}

docs {
  Incluir agendamento. Retorna 409 (HORARIO_OCUPADO) se o responsável já tiver compromisso no horário.
}
