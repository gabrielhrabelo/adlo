meta {
  name: Verificar disponibilidade
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/agendamentos/disponibilidade?dataHora={{dataHora}}&duracaoMinutos=60
  body: none
  auth: inherit
}

params:query {
  dataHora: {{dataHora}}
  duracaoMinutos: 60
  ~usuarioId: {{usuarioId}}
  ~ignorarId: {{agendamentoId}}
}

script:pre-request {
  // Agenda para daqui a 2 dias, às 14h (horário de Brasília)
  const data = new Date(Date.now() + 2 * 24 * 60 * 60 * 1000);
  const dia = data.toISOString().slice(0, 10);
  bru.setVar("dataHora", `${dia}T17:00:00.000Z`);
  bru.setVar("dataHoraRemarcada", `${dia}T19:00:00.000Z`);
}

docs {
  Verificar se o horário está ocupado (Figura 5).
}
