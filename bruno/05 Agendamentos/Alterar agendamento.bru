meta {
  name: Alterar agendamento
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/agendamentos/{{agendamentoId}}
  body: json
  auth: inherit
}

body:json {
  {
    "titulo": "Audiência de instrução e julgamento",
    "dataHora": "{{dataHoraRemarcada}}",
    "antecedenciaMinutos": 2880
  }
}

script:pre-request {
  // Agenda para daqui a 2 dias, às 14h (horário de Brasília)
  const data = new Date(Date.now() + 2 * 24 * 60 * 60 * 1000);
  const dia = data.toISOString().slice(0, 10);
  bru.setVar("dataHora", `${dia}T17:00:00.000Z`);
  bru.setVar("dataHoraRemarcada", `${dia}T19:00:00.000Z`);
}

docs {
  Remarcar recalcula o lembrete e permite um novo alerta.
}
