meta {
  name: Listar agendamentos
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/agendamentos?page=1&pageSize=20
  body: none
  auth: inherit
}

params:query {
  page: 1
  pageSize: 20
  ~clienteId: {{clienteId}}
  ~usuarioId: {{usuarioId}}
  ~processoId: {{processoId}}
  ~tipo: AUDIENCIA
  ~status: PENDENTE
  ~de: 2026-01-01
  ~ate: 2026-12-31
}
