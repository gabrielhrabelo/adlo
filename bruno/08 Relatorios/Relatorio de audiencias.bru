meta {
  name: Relatório de audiências (PDF)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/relatorios/audiencias
  body: none
  auth: inherit
}

params:query {
  ~de: 2026-01-01
  ~ate: 2026-12-31
  ~usuarioId: {{usuarioId}}
  ~status: PENDENTE
}

docs {
  Sem período, considera de hoje até 30 dias à frente (máximo de 366 dias).
}
