meta {
  name: Listar clientes
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/clientes?page=1&pageSize=20
  body: none
  auth: inherit
}

params:query {
  page: 1
  pageSize: 20
  ~busca: maria
  ~ativo: true
  ~area: INSS
  ~cidade: Aparecida de Goiânia
  ~ordenarPor: nome
}

docs {
  RF03 - Consultar cliente com busca (nome, CPF/CNPJ, email, telefone) e filtros.
}
