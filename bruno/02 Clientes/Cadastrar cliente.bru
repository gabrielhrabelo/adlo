meta {
  name: Cadastrar cliente
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/clientes
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Maria da Silva",
    "cpfCnpj": "{{cpf}}",
    "email": "maria@example.com",
    "dataNascimento": "1970-05-20",
    "observacoes": "Cliente indicada por parceiro",
    "telefones": [
      { "tipo": "CELULAR", "numero": "(62) 99999-1234" }
    ],
    "enderecos": [
      {
        "tipo": "RESIDENCIAL",
        "rua": "Rua Sicília",
        "numero": "100",
        "bairro": "Centro",
        "cep": "74900-000",
        "cidade": "Aparecida de Goiânia",
        "uf": "GO"
      }
    ]
  }
}

script:pre-request {
  // Gera um CPF válido a cada execução, para não colidir com cadastros anteriores
  const n = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10));
  const dv = (digitos) => {
    const soma = digitos.reduce((acc, d, i) => acc + d * (digitos.length + 1 - i), 0);
    const resto = (soma * 10) % 11;
    return resto === 10 ? 0 : resto;
  };
  n.push(dv(n));
  n.push(dv(n));
  bru.setVar("cpf", n.join(""));
}

script:post-response {
  if (res.status === 201) bru.setEnvVar("clienteId", res.body.id);
}

docs {
  RF02 - Cadastrar cliente. Salva o id em `clienteId`.
}
