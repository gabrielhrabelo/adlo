meta {
  name: Cadastrar processo
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/processos
  body: json
  auth: inherit
}

body:json {
  {
    "clienteId": "{{clienteId}}",
    "numeroProcesso": "{{numeroProcesso}}",
    "titulo": "Auxílio-doença - concessão",
    "area": "INSS",
    "tribunal": "TRF1",
    "descricao": "Pedido de concessão de auxílio-doença negado administrativamente"
  }
}

script:pre-request {
  // Gera um número CNJ válido (NNNNNNN-DD.AAAA.J.TR.OOOO), com DV por módulo 97
  const n = String(Math.floor(Math.random() * 1e7)).padStart(7, "0");
  const aaaa = String(new Date().getFullYear());
  const j = "4", tr = "01", oooo = "0001";
  const dv = String(98n - (BigInt(n + aaaa + j + tr + oooo + "00") % 97n)).padStart(2, "0");
  bru.setVar("numeroProcesso", `${n}-${dv}.${aaaa}.${j}.${tr}.${oooo}`);
}

script:post-response {
  if (res.status === 201) bru.setEnvVar("processoId", res.body.id);
}

docs {
  RF06 - Cadastrar processo. Salva o id em `processoId`.
}
