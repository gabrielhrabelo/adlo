meta {
  name: Listar processos
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/processos?page=1&pageSize=20
  body: none
  auth: inherit
}

params:query {
  page: 1
  pageSize: 20
  ~busca: auxílio
  ~clienteId: {{clienteId}}
  ~status: TRIAGEM
  ~area: INSS
  ~incluirArquivados: true
  ~ordenarPor: criadoEm
}
