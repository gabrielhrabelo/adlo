meta {
  name: Criar board
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/boards
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Processos INSS"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("boardId", res.body.id);
    // Coluna "Protocolo": usada para mover o card no teste do RF17
    const coluna = res.body.colunas.find((c) => c.status === "PROTOCOLO") ?? res.body.colunas[0];
    if (coluna) bru.setEnvVar("colunaId", coluna.id);
  }
}

docs {
  Sem `colunas`, cria uma coluna por etapa do processo (Triagem ... Concluído), cada uma vinculada ao status.
}
