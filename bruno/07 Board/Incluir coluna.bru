meta {
  name: Incluir coluna
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/boards/{{boardId}}/colunas
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Arquivados",
    "status": "ARQUIVADO"
  }
}

docs {
  `status` vincula a coluna a um status do processo (cada status só pode estar em uma coluna). `posicao` é opcional (0 = início).
}
