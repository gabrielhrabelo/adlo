meta {
  name: Incluir card
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/boards/{{boardId}}/cards
  body: json
  auth: inherit
}

body:json {
  {
    "processoId": "{{processoId}}"
  }
}

script:post-response {
  if (res.status === 201) {
    const card = res.body.colunas.flatMap((c) => c.cards).find((c) => c.processoId === bru.getEnvVar("processoId"));
    if (card) bru.setEnvVar("cardId", card.id);
  }
}

docs {
  Sem `colunaId`, o card entra na coluna do status atual do processo. Sem `titulo`, usa número e título do processo.
}
